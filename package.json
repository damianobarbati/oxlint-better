{
  "name": "oxlint-better-monorepo",
  "private": true,
  "repository": "https://github.com/damianobarbati/oxlint-better",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter oxlint-better run build",
    "lint": "oxlint --deny-warnings --format unix . && oxfmt --check . && pnpm -r run lint",
    "test": "pnpm run build && pnpm -r run test",
    "release": "pnpm --filter oxlint-better publish --no-git-checks"
  },
  "devDependencies": {
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "packageManager": "pnpm@12.23.0"
}
